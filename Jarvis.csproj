<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>Jarvis</RootNamespace>
    <AssemblyName>Jarvis</AssemblyName>
    <Description>Голосовой ассистент для домашнего компьютера</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="System.Speech" Version="10.0.13" />
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>

</Project>
